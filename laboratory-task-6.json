k Out the Feature-Map Sizes","html_id":"id-2-work-out-the-feature-map-sizes","implicit":true,"key":"q2WshdI6o4"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Output size = floor((Input + 2P − K) / S) + 1, where P is padding, K is kernel size, and S is stride.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p7sovO2i7j"}],"key":"mjcWVlNJMO"}],"identifier":"805bb146","label":"805bb146","html_id":"id-805bb146","key":"hKu8sJPOC1"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"e594f40d","outputId":"9a7d5d20-0cf7-4ecd-aaef-5db085e86359"},"children":[{"type":"code","lang":"python","executable":true,"value":"def out_size(size, k, s, p):\n    return (size + 2 * p - k) // s + 1\n\ns = 28\ns = out_size(s, 3, 1, 1); print(\"After Conv1   :\", s)\ns = out_size(s, 2, 1, 1); print(\"After MaxPool1:\", s)\ns = out_size(s, 3, 1, 1); print(\"After Conv2   :\", s)\ns = out_size(s, 3, 1, 1); print(\"After Conv3   :\", s)\ns = out_size(s, 3, 1, 1); print(\"After Conv4   :\", s)\ns = out_size(s, 2, 1, 0); print(\"After MaxPool2:\", s)\n\nflat = 256 * s * s\nprint(\"Flatten size  :\", flat)","identifier":"e594f40d-code","enumerator":"2","html_id":"e594f40d-code","key":"DwtZlenjFE"},{"type":"outputs","id":"-zECfTFEyQ3SUP1VJHAhr","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"After Conv1   : 28\nAfter MaxPool1: 29\nAfter Conv2   : 29\nAfter Conv3   : 29\nAfter Conv4   : 29\nAfter MaxPool2: 28\nFlatten size  : 200704\n"},"children":[],"identifier":"e594f40d-outputs-0","html_id":"e594f40d-outputs-0","key":"ooXZsx8Jog"}],"identifier":"e594f40d-outputs","html_id":"e594f40d-outputs","key":"T0Pcg0lLvz"}],"identifier":"e594f40d","label":"e594f40d","html_id":"e594f40d","key":"sThhXZhnJU"},{"type":"block","kind":"notebook-content","data":{"id":"248f4252"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Build the CNN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IrU6zLgp5J"}],"identifier":"id-3-build-the-cnn","label":"3. Build the CNN","html_id":"id-3-build-the-cnn","implicit":true,"key":"zQOXxZr6Kl"}],"identifier":"248f4252","label":"248f4252","html_id":"id-248f4252","key":"SEHMcHp3So"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"c10a57b7","outputId":"2a4c6693-aa24-48e6-98d6-9d465dfcac5c"},"children":[{"type":"code","lang":"python","executable":true,"value":"model = nn.Sequential(\n    nn.Conv2d(1, 32, 3, stride=1, padding=1),\n    nn.ReLU(),\n    nn.MaxPool2d(2, stride=1, padding=1),\n\n    nn.Conv2d(32, 64, 3, stride=1, padding=1),\n    nn.ReLU(),\n    nn.Conv2d(64, 128, 3, stride=1, padding=1),\n    nn.ReLU(),\n    nn.Conv2d(128, 256, 3, stride=1, padding=1),\n    nn.ReLU(),\n    nn.MaxPool2d(2, stride=1, padding=0),\n\n    nn.Dropout(0.2),\n    nn.Flatten(),\n\n    nn.Linear(flat, 1000),\n    nn.ReLU(),\n    nn.Linear(1000, 500),\n    nn.ReLU(),\n    nn.Linear(500, 10),\n    nn.Softmax(dim=1)\n)\n\nprint(model)","identifier":"c10a57b7-code","enumerator":"3","html_id":"c10a57b7-code","key":"rEyYn7RnJP"},{"type":"outputs","id":"gxYxOf1dMV7FzYjOgO7Zl","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Sequential(\n  (0): Conv2d(1, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n  (1): ReLU()\n  (2): MaxPool2d(kernel_size=2, stride=1, padding=1, dilation=1, ceil_mode=False)\n  (3): Conv2d(32, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n  (4): ReLU()\n  (5): Conv2d(64, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n  (6): ReLU()\n  (7): Conv2d(128, 256, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n  (8): ReLU()\n  (9): MaxPool2d(kernel_size=2, stride=1, padding=0, dilation=1, ceil_mode=False)\n  (10): Dropout(p=0.2, inplace=False)\n  (11): Flatten(start_dim=1, end_dim=-1)\n  (12): Linear(in_features=200704, out_features=1000, bias=True)\n  (13): ReLU()\n  (14): Linear(in_features=1000, out_features=500, bias=True)\n  (15): ReLU()\n  (16): Linear(in_features=500, out_features=10, bias=True)\n  (17): Softmax(dim=1)\n)\n"},"children":[],"identifier":"c10a57b7-outputs-0","html_id":"c10a57b7-outputs-0","key":"B4qNx4A2c0"}],"identifier":"c10a57b7-outputs","html_id":"c10a57b7-outputs","key":"zocOnhcdrl"}],"identifier":"c10a57b7","label":"c10a57b7","html_id":"c10a57b7","key":"pqXRQCzE6C"},{"type":"block","kind":"notebook-content","data":{"id":"67d391ba"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Check the Shapes with a Dummy Batch","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gfKOMLj1fX"}],"identifier":"id-4-check-the-shapes-with-a-dummy-batch","label":"4. Check the Shapes with a Dummy Batch","html_id":"id-4-check-the-shapes-with-a-dummy-batch","implicit":true,"key":"fSUnINBO97"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"A random batch of shape ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Gt9lSSLrvg"},{"type":"inlineCode","value":"(32, 1, 28, 28)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"O7Ewdl9MIZ"},{"type":"text","value":" is passed through the model one layer at a time.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ltgMHQw347"}],"key":"zZe9KCn0bk"}],"identifier":"67d391ba","label":"67d391ba","html_id":"id-67d391ba","key":"lbOcK2Unvq"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"cea1f01f","outputId":"47f627f1-ae38-4556-ba84-a5bed38152a0"},"children":[{"type":"code","lang":"pyth