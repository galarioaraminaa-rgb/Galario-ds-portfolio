},"key":"Qgc9H38Pi1"}],"key":"HhKk9ZTfV8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The dataset is the temperature / rainfall / humidity → apples / oranges example from the source notebook.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vrAXE19dxZ"}],"key":"mK742M8inF"}],"identifier":"b5924906","label":"b5924906","html_id":"b5924906","key":"vWqyyQ3uYE"},{"type":"block","kind":"notebook-content","data":{"id":"a3cf0126"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Imports and Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bvZLRRgxeg"}],"identifier":"id-1-imports-and-data","label":"1. Imports and Data","html_id":"id-1-imports-and-data","implicit":true,"key":"xB9aVVu5lF"}],"identifier":"a3cf0126","label":"a3cf0126","html_id":"a3cf0126","key":"RIAva2Inmf"},{"type":"block","kind":"notebook-code","data":{"id":"7b7deabe"},"children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import TensorDataset, DataLoader\n\ntorch.manual_seed(42)\n\n# inputs: temperature, rainfall, humidity\ninputs = np.array([[73, 67, 43], [91, 88, 64], [87, 134, 58],\n                   [102, 43, 37], [69, 96, 70]] * 3, dtype=\"float32\")\n\n# targets: apples, oranges\ntargets = np.array([[56, 70], [81, 101], [119, 133],\n                    [22, 37], [103, 119]] * 3, dtype=\"float32\")","identifier":"7b7deabe-code","enumerator":"1","html_id":"id-7b7deabe-code","key":"UZsN8U5C9X"},{"type":"outputs","id":"g2tUUor1RCD-0QcCuDx9A","children":[],"identifier":"7b7deabe-outputs","html_id":"id-7b7deabe-outputs","key":"A2GpjVqY2e"}],"identifier":"7b7deabe","label":"7b7deabe","html_id":"id-7b7deabe","key":"k1ktBY9eIp"},{"type":"block","kind":"notebook-content","data":{"id":"9d243e54"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Prepare the Dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r4yjxZ99Pc"}],"identifier":"id-2-prepare-the-dataset","label":"2. Prepare the Dataset","html_id":"id-2-prepare-the-dataset","implicit":true,"key":"zBk9c0SOpR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Inputs and targets are standardized so SGD stays stable over 1000 epochs. Predictions are converted back to the original scale at the end.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wrPungXAAc"}],"key":"RWYX14ti1z"}],"identifier":"9d243e54","label":"9d243e54","html_id":"id-9d243e54","key":"DlKlev6tbX"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"e326f6c0","outputId":"1a5d7d2a-b59d-4f54-9ab1-e069816afb8b"},"children":[{"type":"code","lang":"python","executable":true,"value":"x_mean, x_std = inputs.mean(0), inputs.std(0)\ny_mean, y_std = targets.mean(0), targets.std(0)\n\nX = torch.tensor((inputs - x_mean) / x_std)\nY = torch.tensor((targets - y_mean) / y_std)\n\ndataset = TensorDataset(X, Y)\nloader = DataLoader(dataset, batch_size=8, shuffle=True)\n\nprint(\"Samples:\", len(dataset))\nprint(\"Batch size:\", loader.batch_size)","identifier":"e326f6c0-code","enumerator":"2","html_id":"e326f6c0-code","key":"cYsg69fy1D"},{"type":"outputs","id":"Pahw47xAzfe7YC_VSzOGi","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Samples: 15\nBatch size: 8\n"},"children":[],"identifier":"e326f6c0-outputs-0","html_id":"e326f6c0-outputs-0","key":"MdQGVVgTze"}],"identifier":"e326f6c0-outputs","html_id":"e326f6c0-outputs","key":"AfK5athOtU"}],"identifier":"e326f6c0","label":"e326f6c0","html_id":"e326f6c0","key":"oboBlVEUUI"},{"type":"block","kind":"notebook-content","data":{"id":"a0a05ba9"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Define the Model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qZBiYoXzmk"}],"identifier":"id-3-define-the-model","label":"3. Define the Model","html_id":"id-3-define-the-model","implicit":true,"key":"GPk0tnCYtd"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Two ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q3qgJ85T4U"},{"type":"inlineCode","value":"nn.Linear","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DC4b3JS1On"},{"type":"text","value":" layers are used. No activation is placed between them, so the model stays a linear regression.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yquKH77nZP"}],"key":"jk0qXI52M1"}],"identifier":"a0a05ba9","label":"a0a05ba9","html_id":"a0a05ba9","key":"MZ5eGwBgXi"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2318c514","outputId":"c357e723-2b01-49f8-ffd7-5d31a006e3ee"},"children":[{"type":"code","lang":"python","executable":true,"value":"model = nn.Sequential(\n    nn.Linear(3, 4),\n    nn.Linear(4, 2)\n)\nprint(model)","identifier":"2318c514-code","enumerator":"3","html_id":"id-2318c514-code","key":"i7tJsuuTzG"},{"type":"outputs","id":"UAX2ln46aQlXjc8rc4qqm","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Sequential(\n  (0): Linear(in_features=3, out_features=4, bias=True)\n  (1): Linear(in_features=4, out_features=2, bias=True)\n)\n"},"children":[],"identifier":"2318c514-outputs-0","html_id":"id-2318c514-outputs-0","key":"NwjJkhOa74"}],"identifier":"2318c514-outputs","html_id":"id-2318c514-outputs","key":"Xx2j1p1ViZ"}],"identifier":"2318c514","label":"2318c514","html_id":"id-2318c514","key":"xlIVeQwiM0"},{"type":"block","kind":"notebook-content","data":{"id":"0d4a586f"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Loss Function and Optimizer","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q77DCxFvy0"}],"identifier":"id-4-loss-function-and-optimizer","label":"4. Loss Function and Optimizer","html_id":"id-4-loss-function-and-optimizer","implicit":true,"key":"ETiynABNZR"}],"identifier":"0d4a586f","label":"0d4a586f","html_id":"id-0d4a586f","key":"PAxw0iTr2F"},{"type":"block","kind":"notebook-code","data":{"id":"6971fb4e"},"children":[{"type":"code","lang":"python","executable":true,"value":"loss_fn = nn.MSELoss()\noptimizer = torch.optim.SGD(model.parameters(), lr=0.01)","identifier":"6971fb4e-code","enumerator":"4","html_id":"id-6971fb4e-code","key":"ktykTMNxhb"},{"type":"outputs","id":"Qc882tUQy4urVkWicUxc3","children":[],"identifier":"6971fb4e-outputs","html_id":"id-6971fb4e-outputs","key":"cRGDHtISeX"}],"identifier":"6971fb4e","label":"6971fb4e","html_id":"id-6971fb4e","key":"qtAsnesQKB"},{"type":"block","kind":"notebook-content","data":{"id":"9dedda96"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Train for 1000 Epochs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CvGelJ6L89"}],"identifier":"id-5-train-for-1000-epochs","label":"5. Train for 1000 Epochs","html_id":"id-5-train-for-1000-epochs","implicit":true,"key":"ao77e7Pgne"}],"identifier":"9dedda96","label":"9dedda96","html_id":"id-9dedda96","key":"AQvdUBkADK"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"d81b0ad5","outputId":"7b916ea6-a467-4404-8197-9491e822b059"},"children":[{"type":"code","lang":"python","executable":true,"value":"epochs = 1000\n\nfor epoch in range(epochs):\n    total = 0\n    for xb, yb in loader:\n        pred = model(xb)\n        loss = loss_fn(pred, yb)\n\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n\n        total += loss.item() * len(xb)\n\n    if (epoch + 1) % 100 == 0:\n        print(f\"Epoch {epoch + 1}/{epochs}, Loss: {total / len(dataset):.6f}\")","identifier":"d81b0ad5-code","enumerator":"5","html_id":"d81b0ad5-code","key":"jBl18rzMk0"},{"type":"outputs","id":"4PdrMN9yoYePD33I-P5t3","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Epoch 100/1000, Loss: 0.009453\nEpoch 200/1000, Loss: 0.002220\nEpoch 300/1000, Loss: 0.000879\nEpoch 400/1000, Loss: 0.000551\nEpoch 500/1000, Loss: 0.000465\nEpoch 600/1000, Loss: 0.000440\nEpoch 700/1000, Loss: 0.000428\nEpoch 800/1000, Loss: 0.000424\nEpoch 900/1000, Loss: 0.000420\nEpoch 1000/1000, Loss: 0.000416\n"},"children":[],"identifier":"d81b0ad5-outputs-0","html_id":"d81b0ad5-outputs-0","key":"DSP83y9Ck3"}],"identifier":"d81b0ad5-outputs","html_id":"d81b0ad5-outputs","key":"yiNZ1Qpntp"}],"identifier":"d81b0ad5","label":"d81b0ad5","html_id":"d81b0ad5","key":"gWwog9HGk5"},{"type":"block","kind":"notebook-content","data":{"id":"36520b74"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Evaluate the Model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HvfGLs1TnF"}],"identifier":"id-6-evaluate-the-model","label":"6. Evaluate the Model","html_id":"id-6-evaluate-the-model","implicit":true,"key":"lMKBthr0wH"}],"identifier":"36520b74","label":"36520b74","html_id":"id-36520b74","key":"ERt75xY0Fd"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aefc5b0d","outputId":"b5c1519e-891e-4dc9-812c-f03fb3e9e6b5"},"children":[{"type":"code","lang":"python","executable":true,"value":"with torch.no_grad():\n    pred = model(X).numpy() * y_std + y_mean   # back to original scale\n\nmse = np.mean((pred - targets) ** 2)\nprint(\"MSE on original scale:\", round(float(mse), 4))\n\nprint(\"\\nPredictions vs. targets (first 5):\")\nfor i in range(5):\n    print(i + 1, np.round(pred[i], 2), targets[i])","identifier":"aefc5b0d-code","enumerator":"6","html_id":"aefc5b0d-code","key":"QbCNImypHQ"},{"type":"outputs","id":"0MoqErhXvvbPsWDp-GsLd","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"MSE on original scale: 0.4922\n\nPredictions vs. targets (first 5):\n1 [56.79 70.05] [56. 70.]\n2 [ 82.5  100.78] [ 81. 101.]\n3 [118.63 133.13] [119. 133.]\n4 [21.14 37.05] [22. 37.]\n5 [101.95 119.  ] [103. 119.]\n"},"children":[],"identifier":"aefc5b0d-outputs-0","html_id":"aefc5b0d-outputs-0","key":"BE2pHiRrih"}],"identifier":"aefc5b0d-outputs","html_id":"aefc5b0d-outputs","key":"Dn9l0QrkzO"}],"identifier":"aefc5b0d","label":"aefc5b0d","html_id":"aefc5b0d","key":"FDDmCcuVbb"},{"type":"block","kind":"notebook-content","data":{"id":"f5d9ceb7"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Conclusion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"z0pxAJ54Bu"}],"identifier":"conclusion","label":"Conclusion","html_id":"conclusion","implicit":true,"key":"bdkHzSMAsf"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The model uses all the required settings: MSE loss, two fully connected layers, batch size 8, SGD, and 1000 epochs. The last cell shows how close the predictions are to the targets.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vYPUWqYOIh"}],"key":"V7rmhZU2j3"}],"identifier":"f5d9ceb7","label":"f5d9ceb7","html_id":"f5d9ceb7"