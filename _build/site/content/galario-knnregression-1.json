{"version":3,"kind":"Notebook","sha256":"a9b4a2762479b7a548ff839e967f625d255512ded9c6d5f3c7e5409e827203bb","slug":"galario-knnregression-1","location":"/Galario_knnRegression (1).ipynb","dependencies":[],"frontmatter":{"kernelspec":{"name":"python3","display_name":"Python 3"},"exports":[{"format":"ipynb","filename":"Galario_knnRegression (1).ipynb","url":"/Galario_knnRegressio-e4a539a51f46155d44e49998f59cb759.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","data":{"id":"9kdjQITFARwq"},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Name: Aramina P. Galario","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MXfOjQOFJK"}],"key":"EGIatVm1JE"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"DS3A","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"gIBbtvPFU8"}],"key":"ZUk7ncKVpr"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Assignment:","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"KVWBi6xRmf"}],"key":"qhJDmK8ewg"}],"key":"KjtSxvDyll"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Consider again the Cosine signal sampled N times, i.e.\nX  = np.linspace(0.0, 10.0, N)N = 150\ny = np.cos(2","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"EvYPEMcTr9"},{"type":"emphasis","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"np.pi","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"A1g7RahHaW"}],"key":"FtQH1vOAfn"},{"type":"text","value":"X)","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"Xb5Or5Lovk"}],"key":"ks4CN05L8u"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Plot as a function of N the test accuracy for n_neighbors = 1,3,5,10,100. Provide 2-3 sentences","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"HBvZlDZm6a"}],"key":"e1HcuoNujJ"}],"identifier":"9kdjqitfarwq","label":"9kdjQITFARwq","html_id":"id-9kdjqitfarwq","key":"fpRzo0Zs5z"},{"type":"block","kind":"notebook-code","data":{"id":"p1hfuOck_XQX"},"children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.preprocessing import StandardScaler\n","identifier":"p1hfuock_xqx-code","enumerator":"1","html_id":"p1hfuock-xqx-code","key":"dALZjZ1KQ5"},{"type":"outputs","id":"HUy3ZCb9eHbmIhSh5Gv87","children":[],"identifier":"p1hfuock_xqx-outputs","html_id":"p1hfuock-xqx-outputs","key":"JE9rjusOuU"}],"identifier":"p1hfuock_xqx","label":"p1hfuOck_XQX","html_id":"p1hfuock-xqx","key":"cYX4O4h0jQ"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/","height":564},"id":"tDQp437_BXxL","outputId":"fc8a6447-883c-4521-8409-785d4602b7ff"},"children":[{"type":"code","lang":"python","executable":true,"value":"k_values = [1, 3, 5, 10, 100]\n\nN_values = range(150, 401, 10)\n\nplt.figure(figsize=(10,6))\n\nfor k in k_values:\n    test_accuracies = []\n\n    for N in N_values:\n        X = np.linspace(0.0, 10.0, N)\n        y = np.cos(2 * np.pi * X)\n\n        y_class = (y > 0).astype(int)\n\n        X = X.reshape(-1,1)\n\n        X_train, X_test, y_train, y_test = train_test_split(\n            X, y_class, test_size=0.25, random_state=42\n        )\n        scaler = StandardScaler()\n        X_train = scaler.fit_transform(X_train)\n        X_test = scaler.transform(X_test)\n\n        model = KNeighborsClassifier(n_neighbors=k)\n        model.fit(X_train, y_train)\n\n        test_accuracies.append(model.score(X_test, y_test))\n\n    plt.plot(N_values, test_accuracies, label=f\"k = {k}\")\n\nplt.xlabel(\"Number of Samples (N)\")\nplt.ylabel(\"Test Accuracy\")\nplt.title(\"Test Accuracy vs N for Different k (75:25 Split)\")\nplt.legend()\nplt.grid()\nplt.show()","identifier":"tdqp437_bxxl-code","enumerator":"2","html_id":"tdqp437-bxxl-code","key":"frr2i0tHMs"},{"type":"outputs","id":"6H6llxJ5VuN-X9zzXmDGw","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x600 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"8ff6b03355c4036cdcfcc310715f780f","path":"/8ff6b03355c4036cdcfcc310715f780f.png"}}},"children":[],"identifier":"tdqp437_bxxl-outputs-0","html_id":"tdqp437-bxxl-outputs-0","key":"wb8NuDTRVf"}],"identifier":"tdqp437_bxxl-outputs","html_id":"tdqp437-bxxl-outputs","key":"lyqECxEiCh"}],"identifier":"tdqp437_bxxl","label":"tDQp437_BXxL","html_id":"tdqp437-bxxl","key":"ckeZxRoRmQ"},{"type":"block","kind":"notebook-content","data":{"id":"kSCu5uw_Azv2"},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"with small N, large k is either invalid or leads to severe underfitting, while k=1 overfits due to high variance. As N increases, the model becomes more stable and moderate k values achieve higher and more consistent test accuracy, demonstrating that larger datasets reduce variance and improve generalization in KNN.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HbhhZbVj4m"}],"key":"m0EaPmFsBw"}],"identifier":"kscu5uw_azv2","label":"kSCu5uw_Azv2","html_id":"kscu5uw-azv2","key":"r1filXisfd"}],"key":"rFq3aX0boG"},"references":{"cite":{"order":[],"data":{}}}}