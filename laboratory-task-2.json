":true,"key":"YoRJvl6NX4"}],"identifier":"665309dc","label":"665309dc","html_id":"id-665309dc","key":"rxH7fFgYoJ"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"fdc645af","outputId":"fd2b2b89-1160-4ac9-ec6b-1ddd13b5c53a"},"children":[{"type":"code","lang":"python","executable":true,"value":"# input and target\nx1, x2, x3 = 1, 0, 1\ny = 1\n\n# ReLU\ndef relu(z):\n    return max(0, z)\n\n# hidden layer\nz1 = 0.2*x1 + 0.4*x2 + (-0.5)*x3 + (-0.4)\nz2 = -0.3*x1 + 0.1*x2 + 0.2*x3 + 0.2\nh1 = relu(z1)\nh2 = relu(z2)\n\n# output layer\nz3 = -0.3*h1 + (-0.2)*h2 + 0.1\ny_hat = relu(z3)\n\n# error\nerror = y_hat - y\n\nprint(\"Z1 =\", round(z1, 4), \" H1 =\", round(h1, 4))\nprint(\"Z2 =\", round(z2, 4), \" H2 =\", round(h2, 4))\nprint(\"Z3 =\", round(z3, 4))\nprint(\"Prediction =\", round(y_hat, 4))\nprint(\"Error (y_hat - y) =\", round(error, 4))\nprint(\"Squared error =\", round(error**2, 4))","identifier":"fdc645af-code","enumerator":"1","html_id":"fdc645af-code","key":"iBhTy3Dd8c"},{"type":"outputs","id":"SSWbdzP6ln1jVrLnGTX7p","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Z1 = -0.7  H1 = 0\nZ2 = 0.1  H2 = 0.1\nZ3 = 0.08\nPrediction = 0.08\nError (y_hat - y) = -0.92\nSquared error = 0.8464\n"},"children":[],"identifier":"fdc645af-outputs-0","html_id":"fdc645af-outputs-0","key":"x20F4IZ6h4"}],"identifier":"fdc645af-outputs","html_id":"fdc645af-outputs","key":"hluFPhIyZp"}],"identifier":"fdc645af","label":"fdc645af","html_id":"fdc645af","key":"TQUilXhwJP"}],"key":"Inntp49geM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"🍱 A Machine Learning Approach to Predicting Food Delivery Delays","url":"/group-5final-a-machine-learning-approach-to-predic","group":"My Portfolio"},"next":{"title":"Laboratory Task 3 Forward and Backward Propagation","url":"/laboratory-task-3","group":"My Portfolio"}}},"domain":"http://localhost:3000"}